# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Higgsfield ---
# API_KEY и API_SECRET — из https://cloud.higgsfield.ai (SDK комбинирует их
# в заголовок "Authorization: Key {key}:{secret}").
# HIGGSFIELD_APPLICATION="marketing_studio_video" — подтверждено по
# github.com/higgsfield-ai/skills, тот же идентификатор используется и в
# MCP, и в CLI. См. подробности в app/higgsfield_client.py.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai
HIGGSFIELD_APPLICATION=marketing_studio_video
HIGGSFIELD_VIDEO_TIMEOUT_S=600
HIGGSFIELD_POLL_INTERVAL_S=10

# --- Trendsee (опционально) ---
TRENDSEE_API_KEY=

# --- Instagram (Meta Graph API) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Публичное хранилище видео (нужно для публикации в Instagram) ---
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Пути ---
PHOTOS_DIR=./photos
OUTPUT_DIR=./output
STATE_FILE=./state.json

# --- Бренд ---
BRAND_NAME=MOVIREVO
BRAND_DESCRIPTION=Женская одежда: шарфы, свитера, бомберы и ветровки. Продажи на Wildberries и Ozon.
DAILY_VIDEO_COUNT=3
TRENDS_COUNT_TO_SELECT=5
DAILY_RUN_TIME=09:00

LOG_LEVEL=INFO
