# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user_id, кому разрешено пользоваться ботом (через запятую, если несколько).
# Свой user_id можно узнать у @userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------------------
# Anthropic (Claude) — пишет сценарии/промпты
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Higgsfield — генерация видео
# Ключи выдаются в личном кабинете https://cloud.higgsfield.ai
# SDK умеет читать либо HF_KEY целиком, либо пару HF_API_KEY + HF_API_SECRET
# ---------------------------------------------------------------------------
HF_API_KEY=
HF_API_SECRET=

# job_set_type/модель Higgsfield и её параметры.
# По умолчанию — marketing_studio_video (готовый пресет под UGC-рекламу).
# ВАЖНО: перед боевым запуском сверь точный список аргументов командой
#   higgsfield model get marketing_studio_video --json
# т.к. этот job_set_type может требовать заранее созданные product_id/avatar_id
# (см. HIGGSFIELD_PRODUCT_ID / HIGGSFIELD_AVATAR_ID ниже) — подробности в CLAUDE.md
HIGGSFIELD_JOB_TYPE=marketing_studio_video
HIGGSFIELD_MODE=ugc
HIGGSFIELD_ASPECT_RATIO=9:16
HIGGSFIELD_DURATION=10
HIGGSFIELD_RESOLUTION=720p
# Опционально: если Marketing Studio требует заранее созданный product/avatar,
# впиши их id сюда (см. `higgsfield marketing-studio products list/avatars list`).
# Если оставить пустыми, бот попробует передать фото товара напрямую.
HIGGSFIELD_PRODUCT_ID=
HIGGSFIELD_AVATAR_ID=

# ---------------------------------------------------------------------------
# Google Drive — источник фото товаров
# ---------------------------------------------------------------------------
# Путь к JSON-ключу сервисного аккаунта Google (см. README про настройку доступа)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
# ID папки на Google Диске с фото товаров (из ссылки на папку)
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Бренд / прочее
# ---------------------------------------------------------------------------
BRAND_NAME=MOVIREVO
BRAND_DESCRIPTION=Женская одежда: шарфы, свитера, бомберы и ветровки

STATE_FILE=./data/state.json
DOWNLOAD_DIR=./data/photos
OUTPUT_DIR=./data/videos
POLL_INTERVAL_SECONDS=20
