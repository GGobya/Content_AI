[Unit]
Description=MOVIREVO content factory (docker compose)
After=docker.service rclone-gdrive-photos.service network-online.target
Requires=docker.service
Wants=network-online.target rclone-gdrive-photos.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/movirevo
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
